# Normalize source text; never apply text filters to editable models or media.
* text=auto
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.blend binary
*.webp binary
*.png binary
*.jpg binary
*.mp4 binary
