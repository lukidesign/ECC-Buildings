# Machine-local renders, QA evidence, archives, and migration records
/.local/
# Keep the existing Python virtual environment at its original absolute path.
/tools/

# Intermediate Blender scenes and automatic backups
/models/city.blend
/models/apartment.blend
*.blend[0-9]*

# Credentials and generated state
**/.env*
*.pem
*.key
*.p12
*.pfx
*.sqlite
*.db
.DS_Store
**/__pycache__/
**/*.pyc
/web/*.tsbuildinfo

# Dependency/build caches (the web project has additional local exclusions)
**/node_modules/
*.log
